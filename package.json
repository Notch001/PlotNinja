{
  "name": "plotninja",
  "version": "0.1.0",
  "description": "PlotNinja – Drag & Drop Schneide-Software für Silhouette Cameo (Windows)",
  "main": "out/main/index.js",
  "author": "PlotNinja",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "usb": "^2.14.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "de.plotninja.app",
    "productName": "PlotNinja",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "**/node_modules/usb/**",
      "**/node_modules/node-gyp-build/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PlotNinja-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Notch001",
        "repo": "PlotNinja",
        "releaseType": "release"
      }
    ]
  }
}